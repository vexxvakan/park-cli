{
  "name": "@vexxdev/park-cli",
  "version": "1.0.0",
  "description": "Park UI CLI fork for TypeScript 7 and Panda CSS 2, running on Bun",
  "keywords": [
    "cli",
    "components",
    "ui",
    "panda",
    "ark",
    "react",
    "solid",
    "park-ui"
  ],
  "license": "MIT",
  "author": {
    "name": "vexxvakan",
    "url": "https://github.com/vexxvakan"
  },
  "contributors": [
    {
      "name": "grizzly_codes",
      "url": "https://x.com/grizzly_codes"
    }
  ],
  "homepage": "https://github.com/vexxvakan/park-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vexxvakan/park-cli.git"
  },
  "bugs": {
    "url": "https://github.com/vexxvakan/park-cli/issues"
  },
  "type": "module",
  "bin": {
    "park-cli": "dist/index.js"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "bun ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "build": "bun build ./src/index.ts --target bun --outdir dist --minify --sourcemap=linked --packages external",
    "prepublishOnly": "bun run typecheck && bun test ./src && bun run build"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "effect": "3.22.4",
    "magicast": "0.5.5",
    "tsconfck": "3.1.6"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3"
  }
}
