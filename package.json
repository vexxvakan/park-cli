{
  "name": "@park-ui/cli",
  "version": "1.0.1-panda2.0",
  "description": "CLI tool for Park UI components",
  "type": "module",
  "bin": {
    "park-ui": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": {
    "name": "grizzly_codes",
    "url": "https://x.com/grizzly_codes"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cschroeter/park-ui.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/cschroeter/park-ui/issues"
  },
  "homepage": "https://park-ui.com",
  "files": [
    "dist"
  ],
  "keywords": [
    "cli",
    "components",
    "ui",
    "panda",
    "ark",
    "react",
    "solid",
    "park-ui"
  ],
  "exports": {
    ".": {
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "bun ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "build": "bun build ./src/index.ts --target bun --outdir dist --minify --sourcemap=linked --packages external"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "effect": "3.22.4",
    "magicast": "0.5.5",
    "tsconfck": "3.1.6"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3"
  }
}
